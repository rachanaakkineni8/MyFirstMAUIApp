<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.View.CollectionGOGwImagesPage"
             Title="{Binding Title}">

    <Grid Padding="16,24,16,16"
          RowSpacing="6"
          ColumnSpacing="12">

        <!-- EXACT same row/col layout as teacher -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Button 1: spans 2 columns EXACTLY LIKE TEACHER -->
        <Button Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="{Binding Collection}"
                Command="{Binding CollectionClickedCommand}"
                Style="{StaticResource TileButton}" />

        <!-- Button 2 -->
        <Button Grid.Row="1"
                Grid.Column="0"
                Text="{Binding Images}"
                Command="{Binding ImagesClickedCommand}"
                Style="{StaticResource TileButton}" />

        <!-- Button 3 -->
        <Button Grid.Row="1"
                Grid.Column="1"
                Text="{Binding Buttons}"
                Command="{Binding ButtonsClickedCommand}"
                Style="{StaticResource TileButton}" />

        <!-- Button 4 -->
        <Button Grid.Row="2"
                Grid.Column="0"
                Text="{Binding Icons}"
                Command="{Binding IconsClickedCommand}"
                Style="{StaticResource TileButton}" />

        <!-- Button 5 (optional if you want 5 like teacher's) -->
        <Button Grid.Row="2"
                Grid.Column="1"
                Text="{Binding Extras}"
                Command="{Binding ExtrasClickedCommand}"
                Style="{StaticResource TileButton}" />

    </Grid>
</ContentPage>

