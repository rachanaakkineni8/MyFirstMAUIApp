<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.View.MainPage"
             Title="{Binding Title}">

    <Grid Padding="16,24,16,16"
          RowSpacing="6"
          ColumnSpacing="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0"
                Grid.Column ="0"
                Text ="{Binding Layouts}"
                Command = "{Binding LayoutsClickedCommand}"
                Style ="{StaticResource TileButton}" />

        <Button Grid.Row="0"
                Grid.Column ="1"
                Text ="{Binding Images}"
                Command = "{Binding ImagesClickedCommand}"
                Style="{StaticResource TileButton}" />

        <!-- Replaced the two separate tiles with a full-width horizontal pair:
             left is the Collections tile, right is the new rectangular "Marvel Movies" button -->
        <HorizontalStackLayout Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Spacing="12"
                               HorizontalOptions="FillAndExpand">

            <Button
                Text="{Binding Collections}"
                Command="{Binding CollectionsClickedCommand}"
                Style="{StaticResource TileButton}"
                HorizontalOptions="FillAndExpand"
                HeightRequest="64"
                CornerRadius="0" />

            <Button
                Text="Marvel Movies"
                Command="{Binding CollectionsClickedCommand}"
                Style="{StaticResource TileButton}"
                HorizontalOptions="FillAndExpand"
                HeightRequest="64"
                CornerRadius="0" />

        </HorizontalStackLayout>

        <Button Grid.Row="2"
                Grid.Column ="0"
                Grid.ColumnSpan="2"
                Text="{Binding Sqlite}"
                Style="{StaticResource TileButton}" />

    </Grid>

</ContentPage>