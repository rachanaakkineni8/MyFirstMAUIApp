<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.View.ImagesPage"
             Title="{Binding Title}">

    <Grid RowSpacing = "6"
          ColumnSpacing="12"
          Padding = "16,24,16,16">
        

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0"
                Grid.Column ="0"
                Text="{Binding URIImages}"
                Style= "{StaticResource TileButton}"
                Command="{Binding URIImagesClickedCommand}" />

        <Button Grid.Row="0"
                Grid.Column ="1"
                Text="{Binding EmbeddedImages}"
                Style= "{StaticResource TileButton}" 
                Command="{Binding EmbeddedImagesClickedCommand}" />

        <Button Grid.Row="2"
                Grid.Column ="0"
                Grid.ColumnSpan ="2"
                Text="{Binding ActivityIndicator}"
                Style= "{StaticResource TileButton}"
                Command="{Binding ActivityIndicatorClickedCommand}" />

    
    </Grid>
</ContentPage>    