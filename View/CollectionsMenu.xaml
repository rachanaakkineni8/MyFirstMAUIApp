<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.View.CollectionsMenu"
             Title="CollectionsMenu"
             BackgroundColor="White"
             InputTransparent="False"
             Loaded="OnPageLoaded">

    <!-- Root layout explicitly allows input and has padding so it's easy to tap -->
    <VerticalStackLayout x:Name="RootLayout"
                         Padding="20"
                         Spacing="12"
                         InputTransparent="False">

        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <!-- Clickable Collections button -->
        <Button
            x:Name="CollectionsButton"
            Text="Open Collections"
            Clicked="OnCollectionsButtonClicked"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsEnabled="True" />

    </VerticalStackLayout>
</ContentPage>