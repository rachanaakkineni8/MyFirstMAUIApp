<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.View.MarvelMoviesMenu"
             Title="Marvel Movies">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Label Text="Marvel Movies Menu"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Button Text="Marvel Movies"
                Style="{StaticResource TileButton}"
                Clicked="OnMarvelMoviesClicked" />

        <Button Text="Marvel Movies with Images"
                Style="{StaticResource TileButton}"
                Clicked="OnMarvelMoviesWithImagesClicked" />

    </VerticalStackLayout>
</ContentPage>