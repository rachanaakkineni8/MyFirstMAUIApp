<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.View.ControlsMainStepperMenu"
             Title="ControlsMainStepperMenu">
    
    
    <Grid Padding="16, 24, 16, 16"
      RowSpacing="6"
      ColumnSpacing="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0"
                Grid.Column="0"
                Text="{Binding XAML}"
                Style="{StaticResource TileButton}"
                Command="{Binding XAMLClickedCommand}" />

        <Button Grid.Row="0"
                Grid.Column="1"
                Text="{Binding VM}"
                Style="{StaticResource TileButton}"
                Command="{Binding VMClickedCommand}" />

    </Grid>

</ContentPage>